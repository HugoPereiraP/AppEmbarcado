<Window x:Class="AppEmbarcado.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppEmbarcado.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900">
    <Grid Background="#FF282828">
        <Label Content="{Binding DispositivoId}" ContentStringFormat="Dispositivo: {0}" HorizontalAlignment="Left" Height="45" Margin="36,30,0,0" VerticalAlignment="Top" Width="293" Foreground="#FFF6F6F6" FontSize="24"/>
        <Label Content="{Binding Temperatura}" ContentStringFormat="Temperatura: {0}" HorizontalAlignment="Left" Height="45" Margin="36,125,0,0" VerticalAlignment="Top" Width="293" Foreground="#FFF6F6F6" FontSize="24"/>
        <Label Content="{Binding UmidadeAr}" ContentStringFormat="Umidade do ar: {0}" HorizontalAlignment="Left" Height="45" Margin="447,125,0,0" VerticalAlignment="Top" Width="346" Foreground="#FFF6F6F6" FontSize="24" RenderTransformOrigin="1.652,0.076"/>
        <Label Content="{Binding ResistivoAdc}" ContentStringFormat="Sensor resistivo: {0}" HorizontalAlignment="Left" Height="46" Margin="36,238,0,0" VerticalAlignment="Top" Width="330" Foreground="#FFF6F6F6" FontSize="24"/>
        <Label Content="{Binding CapacitivoAdc}" ContentStringFormat="Sensor capacitivo: {0}" HorizontalAlignment="Left" Height="45" Margin="447,238,0,0" VerticalAlignment="Top" Width="414" Foreground="#FFF6F6F6" FontSize="24" RenderTransformOrigin="1.652,0.076"/>
        <Label Content="{Binding StatusBomba}" ContentStringFormat="Status da bomba: {0}" HorizontalAlignment="Left" Height="46" Margin="36,347,0,0" VerticalAlignment="Top" Width="330" Foreground="#FFF6F6F6" FontSize="24"/>
        <Label Content="{Binding UltimaLeitura}" HorizontalAlignment="Left" Height="46" Margin="447,347,0,0" VerticalAlignment="Top" Width="330" Foreground="#FFF6F6F6" FontSize="24"/>
    </Grid>
</Window>
