<Window x:Class="AppEmbarcado.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppEmbarcado • Monitoramento de solo" Height="790" Width="1120"
        MinHeight="580" MinWidth="760" WindowStartupLocation="CenterScreen"
        Background="#F3F6F3" FontFamily="Segoe UI" Foreground="#203D32"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E8E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62776C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SensorTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#163D2E" Padding="32,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2D5743" CornerRadius="12" Width="44" Height="44" Margin="0,0,14,0">
                        <TextBlock Text="&#xE8BE;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#CBE8A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="AppEmbarcado" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="MONITORAMENTO DE SOLO" Foreground="#B5CCBC" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#2D5743" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock Text="ESP32  /  Wi-Fi" Foreground="#E1EEDD" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Visão geral" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Acompanhe as condições do ambiente e as últimas leituras do solo." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="DISPOSITIVO" Style="{StaticResource Caption}" FontSize="10"/>
                            <TextBlock Text="{Binding DispositivoId}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="ÚLTIMA ATUALIZAÇÃO" Style="{StaticResource Caption}" FontSize="10"/>
                            <TextBlock Text="{Binding UltimaLeitura}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="TEMPERATURA" Style="{StaticResource Caption}" Foreground="#996128" FontSize="11"/>
                            <TextBlock Text="{Binding Temperatura}" Style="{StaticResource Value}"/>
                            <TextBlock Text="Temperatura do ambiente • DHT22" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="UMIDADE DO AR" Style="{StaticResource Caption}" Foreground="#35738A" FontSize="11"/>
                            <TextBlock Text="{Binding UmidadeAr}" Style="{StaticResource Value}"/>
                            <TextBlock Text="Umidade relativa do ambiente • DHT22" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SENSOR CAPACITIVO" Style="{StaticResource Caption}" Foreground="#437849" FontSize="11"/>
                            <TextBlock Text="{Binding CapacitivoAdc}" Style="{StaticResource Value}"/>
                            <TextBlock Text="Leitura bruta do solo • GPIO 35" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SENSOR RESISTIVO" Style="{StaticResource Caption}" Foreground="#437849" FontSize="11"/>
                            <TextBlock Text="{Binding ResistivoAdc}" Style="{StaticResource Value}"/>
                            <TextBlock Text="Leitura bruta do solo • GPIO 32" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Background="#E8EFE4" BorderBrush="#D7E3D1" Margin="0,20,0,0" Padding="22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Bomba de irrigação" Style="{StaticResource SensorTitle}"/>
                            <TextBlock Text="Estado informado pelo dispositivo • simulação com LED" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="18" Padding="16,8" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DAE2DD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusBomba}" Value="Ligada">
                                            <Setter Property="Background" Value="#C4E5AD"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusBomba}" Value="Desligada">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusBomba}" FontWeight="SemiBold" FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#DEE6DE" BorderThickness="0,1,0,0" Padding="32,12">
            <TextBlock Text="As leituras de solo são exibidas em ADC. A conversão para umidade depende de calibração." Style="{StaticResource Caption}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
